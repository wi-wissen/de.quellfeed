<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The handover channel between the share extension and the app; must match
	     App/App.entitlements and the suite name in ShareViewController.swift /
	     ShareIntentPlugin.swift. Sideloading tools rewrite this to the signer's
	     own team namespace — see README, section "Releases". -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.quellfeed</string>
	</array>
</dict>
</plist>
