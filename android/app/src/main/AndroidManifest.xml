<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Setup deep links (de.quellfeed://setup#...): the toolbox page on
              quellfeed.de hands the AI configuration over through this. The app never
              applies one silently — App.vue asks first.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="de.quellfeed" />
            </intent-filter>

        </activity>

        <!--
          The share sheet target. NOT MainActivity: an ACTION_SEND there brought the
          whole app visibly to the front just to save a link. ShareActivity draws
          nothing (Theme.NoDisplay, finish() in onCreate) — an article is queued and
          confirmed with a toast while the user stays in their browser; only a
          feed-looking link forwards to MainActivity, because subscribing needs a
          screen. text/plain is what a browser sends when you share a link.
        -->
        <activity
            android:name=".ShareActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: the read-aloud media notification (MediaControlPlugin) needs this
         runtime permission. Asked once on the first play; a refusal only costs the
         system card, never the reading itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
